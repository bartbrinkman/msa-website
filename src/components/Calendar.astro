---
interface Event {
  date: string;       // YYYY-MM-DD (start date)
  endDate?: string;   // YYYY-MM-DD (optional end date)
  startTime?: string; // HH:MM (optional)
  endTime?: string;   // HH:MM (optional)
  title: string;
  description?: string;
  location?: string;
  type?: 'clubavond' | 'expositie' | 'excursie' | 'opendag' | 'beurs' | 'overig';
  link?: string;
}

interface Props {
  events: Event[];
}

import DateBlock from './DateBlock.astro';
import { asset, upcomingEvents as sharedUpcoming } from '../utils';
const { events } = Astro.props;

const typeColors: Record<string, string> = {
  clubavond: 'bg-primary/15 border-primary/40 text-primary',
  expositie: 'bg-emerald-100 border-emerald-300 text-emerald-900',
  excursie: 'bg-amber-100 border-amber-300 text-amber-900',
  opendag: 'bg-sky-100 border-sky-300 text-sky-900',
  beurs: 'bg-violet-100 border-violet-300 text-violet-900',
  overig: 'bg-gray-100 border-gray-300 text-gray-800',
};

const typeLabels: Record<string, string> = {
  clubavond: 'Clubavond',
  expositie: 'Expositie',
  excursie: 'Excursie',
  opendag: 'Open dag',
  beurs: 'Beurs',
  overig: 'Overig',
};

const months = ['januari', 'februari', 'maart', 'april', 'mei', 'juni', 'juli', 'augustus', 'september', 'oktober', 'november', 'december'];
const days = ['zo', 'ma', 'di', 'wo', 'do', 'vr', 'za'];

function formatDate(d: Date) {
  return `${days[d.getDay()]} ${d.getDate()} ${months[d.getMonth()]}`;
}

const upcomingEvents = sharedUpcoming(events);

// Sorted soonest-first, so the head of the list is the next event.
const nextEvent = upcomingEvents[0];

const grouped: Record<string, Event[]> = {};
for (const event of upcomingEvents) {
  const d = new Date(event.date);
  const key = `${months[d.getMonth()]} ${d.getFullYear()}`;
  if (!grouped[key]) grouped[key] = [];
  grouped[key].push(event);
}
---

{Object.keys(grouped).length === 0 ? (
  <p class="text-gray-500 italic">Geen aankomende evenementen gepland.</p>
) : (
  <div class="space-y-8">
    {Object.entries(grouped).map(([month, monthEvents]) => (
      <div>
        <h3 class="text-lg font-semibold text-primary capitalize mb-3">{month}</h3>
        <div class="space-y-3">
          {monthEvents.map((event) => {
            const startD = new Date(event.date);
            const endD = event.endDate ? new Date(event.endDate) : null;
            const type = event.type || 'overig';
            const colors = typeColors[type] || typeColors.overig;
            const isNext = event === nextEvent;
            return (
              <div class={`border rounded-lg p-4 ${colors} ${isNext ? 'ring-1 ring-primary/25 shadow-sm' : ''}`}>
                <div class="flex items-start gap-4">
                  <DateBlock date={event.date} endDate={event.endDate} header="weekday" />
                  <div class="flex-1 min-w-0">
                    {isNext && (
                      <span class="block w-fit mb-2.5 px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-primary/10 text-primary">
                        Eerstvolgende
                      </span>
                    )}
                    {event.link ? (
                      <a href={asset(event.link!)} class="font-semibold hover:opacity-70">{event.title}</a>
                    ) : (
                      <div class="font-semibold">{event.title}</div>
                    )}
                    {event.description && <p class="text-sm mt-1 opacity-80">{event.description}</p>}
                    <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2 text-xs items-center">
                      <span class={`inline-block px-2 py-0.5 rounded-full font-medium ${
                        type === 'expositie' ? 'bg-emerald-100 text-emerald-800' :
                        type === 'excursie' ? 'bg-amber-100 text-amber-800' :
                        type === 'opendag' ? 'bg-sky-100 text-sky-800' :
                        type === 'beurs' ? 'bg-violet-100 text-violet-800' :
                        type === 'clubavond' ? 'bg-primary/20 text-primary' :
                        'bg-gray-100 text-gray-600'
                      }`}>{typeLabels[type]}</span>
                      {event.location && (
                        <span class="opacity-60 inline-flex items-center gap-1">
                          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                          {event.location}
                        </span>
                      )}
                      {(event.startTime || event.endTime) && (
                        <span class="opacity-70 inline-flex items-center gap-1">
                          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                          {event.startTime}{event.startTime && event.endTime ? '–' : ''}{event.endTime}
                        </span>
                      )}
                    </div>
                  </div>
                  {event.link && (
                    <a href={asset(event.link!)} class="btn self-center">
                      Meer info
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    ))}
  </div>
)}
