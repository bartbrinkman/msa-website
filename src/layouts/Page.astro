---
import Base from './Base.astro';
import BrochureStand from '../components/BrochureStand.astro';
import EventCard from '../components/EventCard.astro';
import events from '../content/events.json';
import { asset, upcomingEvents, eventWhen } from '../utils';

interface Props {
  title: string;
  description?: string;
  hero?: string;
  heroImage?: string;
  frequency?: 'Wekelijks' | 'Maandelijks' | 'Jaarlijks';
  /** Renders a back link above the title, e.g. back to the banen overview. */
  backHref?: string;
  backLabel?: string;
  /** Poster/flyer for this activity, shown in the hero as a desk stand. */
  brochure?: string;
  brochureAlt?: string;
  when?: string;
  where?: string;
}

const { title, description, hero, heroImage, frequency, when, where, backHref, backLabel = 'Terug', brochure, brochureAlt } = Astro.props;

// If the agenda holds an upcoming event for this page, it is the authority on
// when this activity happens: the date is shown from the calendar rather than
// written into the page, so it cannot go stale.
const here = Astro.url.pathname.replace(/\/$/, '');
const linkedEvent = upcomingEvents(events).find(
  e => e.link && asset(e.link).replace(/\/$/, '') === here,
);
const whenLabel = linkedEvent ? eventWhen(linkedEvent) : when;
---

<Base title={title} description={description}>
  {hero && (
    <div class="relative bg-gradient-to-r from-primary-dark to-primary">
      {heroImage && (
        <>
          <img src={asset(heroImage!)} alt="" class="absolute inset-0 w-full h-full object-cover opacity-20" />
        </>
      )}
      <div class="relative text-white py-12">
        <div class="max-w-4xl mx-auto px-4 flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
          <div class="min-w-0 flex-1">
          {backHref && (
            <a
              href={asset(backHref)}
              class="group inline-flex items-center gap-1.5 mb-4 rounded-md bg-white/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-wide text-white/80 transition-colors hover:bg-white/20 hover:text-white"
            >
              <svg class="w-3.5 h-3.5 transition-transform group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
              {backLabel}
            </a>
          )}
          {frequency && (
            <span class="inline-block text-xs bg-white/15 text-white px-2 py-0.5 rounded font-medium mb-3">
              {frequency}
            </span>
          )}
          <h1 class="text-3xl md:text-4xl font-medium font-heading uppercase tracking-normal">{hero}</h1>
          {(whenLabel || where) && (
            <dl class="meta">
              {whenLabel && (
                <div>
                  <dt>Wanneer</dt>
                  <dd>{whenLabel}</dd>
                </div>
              )}
              {where && (
                <div>
                  <dt>Waar</dt>
                  <dd>{where}</dd>
                </div>
              )}
            </dl>
          )}
          </div>

          {brochure && <BrochureStand items={[{ src: brochure, alt: brochureAlt ?? `Poster ${hero}` }]} />}
        </div>
      </div>
    </div>
  )}

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="prose">
      <slot />
    </div>

    {linkedEvent && (
      <div class="mt-10">
        <h2 class="text-lg font-medium font-heading uppercase tracking-normal text-primary mb-3">Eerstvolgende editie</h2>
        <EventCard event={linkedEvent} linked={false} />
      </div>
    )}
  </div>
</Base>

