---
import Base from '../../layouts/Base.astro';
import BrochureStand from '../../components/BrochureStand.astro';
import { asset } from '../../utils';
---

<Base title="Activiteiten">
  <div class="relative overflow-x-clip bg-gradient-to-r from-primary-dark to-primary text-white py-12">
    <div class="relative max-w-4xl mx-auto px-4 flex flex-col gap-8 md:block">
      <div class="min-w-0 flex-1">
        <h1 class="text-3xl md:text-5xl font-medium font-heading uppercase tracking-normal leading-tight">Activiteiten</h1>
        <p class="mt-3 text-white/80">Wat wij doen: wekelijks, jaarlijks en alles daartussenin.</p>
      </div>
      <BrochureStand
        float
        items={[
          { src: '/images/brochure/modelspoor-ruilbeurs-2026.jpg', alt: 'Poster van de Modelspoor Ruilbeurs' },
          { src: '/images/brochure/nmd-dagen-2027.jpg', alt: 'Poster van de Noord-Hollandse Modelspoordagen' },
        ]}
      />
    </div>
  </div>


  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="grid md:grid-cols-2 gap-6">

      <a href={asset("/activiteiten/clubavonden")} class="group card card__body card-hover bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-center gap-2 mb-2">
          <span class="tag">Wekelijks</span>
        </div>
        <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">Clubavonden</h2>
        <p class="text-gray-600 text-sm mt-1 mb-4">Iedere donderdagavond werken wij aan onze banen. Kom gerust een keer langs.</p>
        <div class="btn">
          Meer lezen
        </div>
      </a>

      <a href={asset("/activiteiten/modelspoordagen")} class="group card card__body card-hover bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-center gap-2 mb-2">
          <span class="tag">Jaarlijks</span>
        </div>
        <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">Noord-Hollandse Modelspoordagen</h2>
        <p class="text-gray-600 text-sm mt-1 mb-4">Ons grote jaarlijkse publieksevenement samen met andere clubs uit de regio.</p>
        <div class="btn">
          Meer lezen
        </div>
      </a>

      <a href={asset("/activiteiten/darmstadt")} class="group card card__body card-hover bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-center gap-2 mb-2">
          <span class="tag">Jaarlijks</span>
        </div>
        <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">Excursie Darmstadt</h2>
        <p class="text-gray-600 text-sm mt-1 mb-4">Jaarlijks bezoek aan het Eisenbahnmuseum in Darmstadt, waar wij ook een baan exposeren.</p>
        <div class="btn">
          Meer lezen
        </div>
      </a>

      <a href={asset("/activiteiten/open-dag")} class="group card card__body card-hover bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-center gap-2 mb-2">
          <span class="tag">Jaarlijks</span>
        </div>
        <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">Open Dag</h2>
        <p class="text-gray-600 text-sm mt-1 mb-4">Onze jaarlijkse open dag: alle banen rijden en zijn te bezichtigen voor publiek.</p>
        <div class="btn">
          Meer lezen
        </div>
      </a>

      <a href={asset("/activiteiten/open-monumentendag")} class="group card card__body card-hover bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-center gap-2 mb-2">
          <span class="tag">Jaarlijks</span>
        </div>
        <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">Open Monumentendag</h2>
        <p class="text-gray-600 text-sm mt-1 mb-4">Jaarlijkse deelname aan de Erfgoedmarkt in de Grote Kerk van Alkmaar.</p>
        <div class="btn">
          Meer lezen
        </div>
      </a>

      <a href={asset("/activiteiten/ruilbeurs")} class="group card card__body card-hover bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-center gap-2 mb-2">
          <span class="tag">Jaarlijks</span>
        </div>
        <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">Ruilbeurs</h2>
        <p class="text-gray-600 text-sm mt-1 mb-4">Modelspoorbeurs waar liefhebbers materiaal kunnen kopen, verkopen en ruilen.</p>
        <div class="btn">
          Meer lezen
        </div>
      </a>

      <a href={asset("/activiteiten/huider")} class="group card card__body card-hover bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:border-primary/30">
        <div class="flex items-center gap-2 mb-2">
          <span class="tag">Maandelijks</span>
        </div>
        <h2 class="text-lg font-semibold text-primary group-hover:text-primary-light transition-colors">Open Dag Huider</h2>
        <p class="text-gray-600 text-sm mt-1 mb-4">Iedere tweede zaterdag van de maand open dag bij Huider Modelbouw in Heerhugowaard.</p>
        <div class="btn">
          Meer lezen
        </div>
      </a>

    </div>

    <div class="mt-8 p-6 bg-white border border-gray-200 rounded-xl shadow-sm">
      <p class="text-gray-700">
        Bekijk de <a href={asset("/agenda")} class="text-primary-light font-semibold">agenda</a> voor aankomende data.
      </p>
    </div>
  </div>
</Base>
