---
import Page from '../../layouts/Page.astro';
import Carousel from '../../components/Carousel.astro';
import { asset } from '../../utils';
import carousels from '../../content/carousels.json';

const images = carousels.modelspoordagen;
---

<Page
  title="Noord-Hollandse Modelspoordagen"
  hero="Noord-Hollandse Modelspoordagen"
  heroImage="/images/modelspoordagen/nmd_2025_2.jpg"
  frequency="Jaarlijks"
  when="Winter"
  where="Alkmaar"
  brochure="/images/brochure/nmd-dagen-2027.jpg"
  brochureAlt="Poster van de Noord-Hollandse Modelspoordagen"
>
  <h2>Het evenement</h2>
  <p>
    De Noord-Hollandse Modelspoordagen (NMD) is het jaarlijkse publieksevenement
    waar meerdere modelspoorclubs uit Noord-Holland hun banen tonen aan een
    breed publiek. Het is een weekend vol rijdende treinen, een modeltreinbeurs
    en enthousiaste bouwers.
  </p>

  <Carousel images={images} id="modelspoordagen" />

  <h2>Wat is er te zien?</h2>
  <ul>
    <li>Modelspoorbanen in diverse schalen en thema's</li>
    <li>Live demonstraties van digitale besturing</li>
    <li>Treinsimulatoren</li>
  </ul>

  <h2>Organisatie</h2>
  <p>
    De NMD wordt georganiseerd door de deelnemende modelspoorclubs uit
    Noord-Holland samen. Zo ontstaat een gevarieerd programma voor zowel
    liefhebbers als nieuwsgierige bezoekers.
  </p>
  <p>
    Meer informatie op <a href="https://www.nhmd.nl" target="_blank" rel="noopener">nhmd.nl</a>.
  </p>

</Page>
