---
import Page from '../../layouts/Page.astro';
import Carousel from '../../components/Carousel.astro';
import carousels from '../../content/carousels.json';
import banen from '../../content/banen.json';

const images = carousels.alkmaarbaan;
const verbouwingImages = carousels['alkmaarbaan-verbouwing'];

const baan = banen.find(b => b.href === '/banen/alkmaarbaan')!;
---

<Page backHref="/banen" backLabel="Alle banen" title="Alkmaarbaan" hero="Alkmaarbaan" heroImage={baan.image}>
  <p><strong>Schaal:</strong> H0 (1:87) | <strong>Systeem:</strong> 2-rail DC | <strong>Besturing:</strong> iTrain</p>

  <h2>Het verhaal</h2>
  <p>
    De Alkmaarbaan is de oudste baan van de club en stelt station Alkmaar
    voor in de jaren vijftig. Het historische stationsgebouw, de draaibrug
    over het Noordhollands Kanaal en de bolbrug over het kanaal bij
    Heerhugowaard zijn herkenbare elementen uit die tijd.
  </p>

  <Carousel images={images} id="alkmaarbaan" />

  <h2>Bijzondere kenmerken</h2>
  <ul>
    <li>Historisch stationsgebouw van Alkmaar met voetgangersbrug</li>
    <li>Draaibrug over het Noordhollands Kanaal</li>
    <li>Bolbrug over het kanaal bij Heerhugowaard</li>
    <li>Draaischijf met stappenmotor en 3D-geprinte onderdelen</li>
    <li>Depotgebied met rangeerterrein</li>
    <li>Volledig computergestuurd via iTrain</li>
  </ul>

  <h2>Techniek</h2>
  <p>
    Oorspronkelijk reden er zowel analoge als digitale treinen op de baan,
    beide aangestuurd via het Dinamo-systeem. Inmiddels rijden er alleen
    nog digitale treinen. Dinamo is nog steeds in gebruik voor de
    digitale aansturing, en de baan wordt computergestuurd via iTrain.
  </p>

  <h2>Lopende projecten</h2>
  <ul>
    <li>Renovatie van station Heerhugowaard en het schaduwstation</li>
    <li>Update van de besturing met extra systeemkaarten</li>
  </ul>
  <p>
    Het streven is dat de baan op onze jaarlijkse open dag weer volledig
    in bedrijf is.
  </p>

  {verbouwingImages.length > 0 && (
    <Carousel images={verbouwingImages} id="alkmaarbaan-verbouwing" />
  )}
</Page>
