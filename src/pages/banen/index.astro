---
import Base from '../../layouts/Base.astro';
import LayoutCard from '../../components/LayoutCard.astro';
import banen from '../../content/banen.json';

const vast = banen.filter(b => b.category === 'vast');
const modules = banen.filter(b => b.category === 'module');
---

<Base title="Onze Banen">
  <div class="bg-gradient-to-r from-primary-dark to-primary text-white py-12">
    <div class="max-w-6xl mx-auto px-4">
      <h1 class="text-3xl md:text-5xl font-medium font-heading uppercase tracking-normal leading-tight">Onze Banen</h1>
      <p class="mt-3 text-white/80 max-w-2xl">
De MSA beschikt over meerdere modelspoorbanen, elk met een eigen karakter
        en schaal. Van historisch station tot een 45 meter lange modulebaan.
</p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 py-8 md:py-12">
    <h2 class="section-title text-xl md:text-2xl font-medium font-heading uppercase text-primary mb-6">Vaste banen</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {vast.map((baan) => (
        <LayoutCard
          title={baan.title}
          href={baan.href}
          scale={baan.scale}
          description={baan.description}
          status={baan.status}
          image={baan.image}
        />
      ))}
    </div>

    <h2 class="section-title text-xl md:text-2xl font-medium font-heading uppercase text-primary mt-12 mb-6">Modulebanen</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {modules.map((baan) => (
        <LayoutCard
          title={baan.title}
          href={baan.href}
          scale={baan.scale}
          description={baan.description}
          status={baan.status}
          image={baan.image}
        />
      ))}
    </div>
    
  </div>
</Base>
