---
import Base from '../layouts/Base.astro';
import LayoutCard from '../components/LayoutCard.astro';
import DateBlock from '../components/DateBlock.astro';
import banen from '../content/banen.json';
import events from '../content/events.json';
import { getCollection } from 'astro:content';
import { asset, months, typeLabels, upcomingEvents } from '../utils';

const upcoming = upcomingEvents(events, 3);

// Six for a 3x2 grid; the rest live on the banen overview.
const featuredBanen = banen.slice(0, 6);

const nieuws = (await getCollection('nieuws', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Hero slideshow. Each source is pre-cropped (see originals/README.md) to a wide
// band with its subject on the 2/3 line, so the markup needs no per-image framing.
const heroSlides = [
  { src: '/images/hero/0.jpg' },
  { src: '/images/hero/1.jpg' },
  { src: '/images/hero/2.jpg' },
  { src: '/images/hero/3.jpg' },
];

// Anchoring the zoom on the 2/3 line keeps the subject there through the motion.
const SUBJECT_X = '67%';
const SLIDE_SECONDS = 8;
---

<Base title="Home">
  <!-- Hero -->
  <section class="relative flex items-center overflow-hidden min-h-[clamp(280px,26vw,520px)]">
    <div class="absolute inset-0" aria-hidden="true">
      {heroSlides.map((slide, i) => (
        <img
          src={asset(slide.src)}
          alt=""
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class="hero-slide absolute inset-0 h-full w-full object-cover"
          style={`object-position: ${SUBJECT_X} 50%; transform-origin: ${SUBJECT_X} 50%; animation-delay: ${i * SLIDE_SECONDS}s;`}
        />
      ))}
    </div>
    <!-- Scrim: opaque behind the copy, thinning to the right so the layout's
         greens and yellows stay visible. -->
    <div class="absolute inset-0 bg-gradient-to-r from-primary-dark/95 to-primary-dark/75 md:from-primary-dark/95 md:via-primary-dark/75 md:via-45% md:to-primary-dark/10"></div>
    <div class="relative w-full text-white py-12 md:py-16">
      <div class="max-w-6xl mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-medium mb-3 font-heading uppercase tracking-normal">Modelspoorclub Alkmaar</h1>
        <p class="text-base md:text-lg text-white/80 max-w-2xl mb-6">
          Al meer dan 40 jaar bouwen wij met passie aan modelspoorbanen.
          Van historisch Alkmaar tot industriële hoogovens. Ontdek onze banen.
        </p>
        <div class="flex gap-4 flex-wrap">
          <a href={asset("/banen")} class="bg-white text-primary px-6 py-3 rounded-lg font-semibold hover:bg-warm transition-colors">
            Bekijk onze banen
          </a>
          <a href={asset("/de-club")} class="border border-white/30 text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors">
            Wie zijn wij
          </a>
          <a href={asset("/contact")} class="border border-white/30 text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors">
            Bezoek ons
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming activities -->
  {upcoming.length > 0 && (
    <section class="py-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
          <h2 class="text-2xl font-medium text-primary font-heading uppercase tracking-normal">Aankomende activiteiten</h2>
          <a href={asset("/agenda")} class="text-primary hover:underline text-sm font-semibold">Volledige agenda →</a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {upcoming.map((event, i) => {
            const startD = new Date(event.date);
            const endD = event.endDate ? new Date(event.endDate) : null;
            const type = event.type || 'overig';
            const badgeClass =
              type === 'expositie' ? 'bg-emerald-200 text-emerald-900' :
              type === 'excursie' ? 'bg-amber-200 text-amber-900' :
              type === 'opendag' ? 'bg-sky-200 text-sky-900' :
              type === 'beurs' ? 'bg-violet-200 text-violet-900' :
              type === 'clubavond' ? 'bg-primary/25 text-primary' :
              'bg-gray-200 text-gray-700';
            const Tag = event.link ? 'a' : 'div';
            // The list is sorted soonest-first, so index 0 is the next event.
            const isNext = i === 0;
            const cardClass = [
              'bg-white rounded-lg p-6 flex gap-4',
              isNext
                ? 'border border-primary/40 ring-1 ring-primary/15 shadow-sm'
                : 'border border-gray-200',
              !event.link ? '' : isNext
                ? 'group hover:shadow-lg transition-all'
                : 'group hover:border-primary/30 hover:shadow-lg transition-all',
            ].filter(Boolean).join(' ');
            const linkProps = event.link
              ? { href: asset(event.link), class: cardClass }
              : { class: cardClass };
            return (
              <Tag {...linkProps}>
                <DateBlock date={event.date} endDate={event.endDate} />
                <div class="flex-1 min-w-0">
                  <div class="flex flex-wrap items-center gap-1.5 mb-2">
                    {isNext && (
                      <span class="inline-block px-2 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wide bg-primary/10 text-primary">
                        Eerstvolgende
                      </span>
                    )}
                    <span class={`inline-block px-2 py-0.5 rounded-full text-xs font-medium ${badgeClass}`}>{typeLabels[type]}</span>
                  </div>
                  <div class="font-semibold text-primary group-hover:text-primary-light transition-colors">{event.title}</div>
                  {event.description && <p class="text-sm text-gray-600 mt-1">{event.description}</p>}
                  {(event.startTime || event.endTime || event.location) && (
                    <div class="text-xs text-gray-500 mt-2 flex flex-wrap gap-x-3">
                      {event.location && (
                        <span class="inline-flex items-center gap-1">
                          <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                          {event.location}
                        </span>
                      )}
                      {(event.startTime || event.endTime) && (
                        <span class="inline-flex items-center gap-1">
                          <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                          {event.startTime}{event.startTime && event.endTime ? '–' : ''}{event.endTime}
                        </span>
                      )}
                    </div>
                  )}
                </div>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- Featured layouts -->
  <section class="py-12 bg-primary-dark text-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
        <h2 class="text-2xl font-medium text-white font-heading uppercase tracking-normal">Onze banen</h2>
        <a href={asset("/banen")} class="text-white/75 hover:text-white text-sm font-semibold transition-colors">Bekijk alle banen →</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredBanen.map((baan) => (
          <LayoutCard
            title={baan.title}
            href={baan.href}
            scale={baan.scale}
            description={baan.description}
            status={baan.status}
            image={baan.image}
            dark
          />
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Ken Burns: each slide holds for SLIDE_SECONDS, zooming from its own origin,
       then crossfades into the next. Four slides at 8s = a 32s loop. */
    .hero-slide {
      opacity: 0;
      transform: scale(1.04);
      animation: hero-kenburns 32s linear infinite;
      will-change: transform, opacity;
    }

    @keyframes hero-kenburns {
      0%      { opacity: 0; transform: scale(1.04); }
      3%      { opacity: 1; }
      25%     { opacity: 1; }
      28%     { opacity: 0; transform: scale(1.16); }
      28.01%  { transform: scale(1.04); }
      100%    { opacity: 0; transform: scale(1.04); }
    }

    /* No drift, no crossfade: just the first frame. */
    @media (prefers-reduced-motion: reduce) {
      .hero-slide { animation: none; transform: none; opacity: 0; }
      .hero-slide:first-child { opacity: 1; }
    }
  </style>

  <!-- Nieuwsberichten -->
  {nieuws.length > 0 && (
    <section class="py-12">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-baseline justify-between mb-6 flex-wrap gap-2">
          <h2 class="text-2xl font-medium text-primary font-heading uppercase tracking-normal">Nieuws</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {nieuws.map((item) => {
            const d = item.data.date;
            const Tag = item.data.link ? 'a' : 'div';
            const props = item.data.link
              ? { href: asset(item.data.link), class: 'group flex flex-col bg-white border border-gray-200 rounded-lg overflow-hidden hover:border-primary/30 hover:shadow-lg transition-all' }
              : { class: 'flex flex-col bg-white border border-gray-200 rounded-lg overflow-hidden' };
            return (
              <Tag {...props}>
                {item.data.image && (
                  <img src={asset(item.data.image)} alt="" loading="lazy" decoding="async" class="h-40 w-full object-cover" />
                )}
                <div class="flex flex-col flex-1 p-6">
                  <time datetime={d.toISOString().slice(0, 10)} class="text-xs uppercase tracking-wide text-gray-500">
                    {d.getDate()} {months[d.getMonth()]} {d.getFullYear()}
                  </time>
                  <h3 class="mt-1 font-semibold text-primary group-hover:text-primary-light transition-colors">{item.data.title}</h3>
                  <p class="mt-2 text-sm text-gray-600 flex-1">{item.data.summary}</p>
                  {item.data.link && (
                    <span class="mt-4 text-sm text-primary-light font-medium inline-flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                      Meer lezen &rarr;
                    </span>
                  )}
                </div>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )}

</Base>
