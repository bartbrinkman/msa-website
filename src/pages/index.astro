---
import Base from '../layouts/Base.astro';
import LayoutCard from '../components/LayoutCard.astro';
import EventCard from '../components/EventCard.astro';
import banen from '../content/banen.json';
import events from '../content/events.json';
import { getCollection } from 'astro:content';
import { asset, months, upcomingEvents } from '../utils';

const upcoming = upcomingEvents(events, 3);

// Six for a 3x2 grid; the rest live on the banen overview.
const featuredBanen = banen.slice(0, 6);

const nieuws = (await getCollection('nieuws', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Hero slideshow. Each source is pre-cropped (see originals/README.md) to a wide
// band with its subject on the 2/3 line, so the markup needs no per-image framing.
const heroSlides = [
  { src: '/images/hero/0.jpg' },
  { src: '/images/hero/1.jpg' },
  { src: '/images/hero/2.jpg' },
  { src: '/images/hero/3.jpg' },
];

// Anchoring the zoom on the 2/3 line keeps the subject there through the motion.
const SUBJECT_X = '67%';
const SLIDE_SECONDS = 8;
---

<Base title="Home">
  <!-- Hero -->
  <section class="relative flex items-center overflow-hidden min-h-[clamp(280px,26vw,520px)]">
    <div class="absolute inset-0" aria-hidden="true">
      {heroSlides.map((slide, i) => (
        <img
          src={asset(slide.src)}
          alt=""
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          class="hero-slide absolute inset-0 h-full w-full object-cover"
          style={`object-position: ${SUBJECT_X} 50%; transform-origin: ${SUBJECT_X} 50%; animation-delay: ${i * SLIDE_SECONDS}s;`}
        />
      ))}
    </div>
    <!-- Scrim: opaque behind the copy, thinning to the right so the layout's
         greens and yellows stay visible. -->
    <div class="absolute inset-0 bg-gradient-to-r from-primary-dark/95 to-primary-dark/75 md:from-primary-dark/95 md:via-primary-dark/75 md:via-45% md:to-primary-dark/10"></div>
    <div class="relative w-full text-white py-14 md:py-20">
      <div class="max-w-6xl mx-auto px-4">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-msa-gold mb-3">Sinds 1984</p>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-medium mb-4 font-heading uppercase tracking-normal leading-tight">Modelspoorclub Alkmaar</h1>
        <p class="text-base md:text-lg text-white/80 max-w-2xl mb-8">
          Al meer dan 40 jaar bouwen wij met passie aan modelspoorbanen.
          Van historisch Alkmaar tot industriële hoogovens. Ontdek onze banen.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a href={asset("/banen")} class="text-center bg-white text-primary px-6 py-3 rounded-lg font-semibold shadow-md hover:bg-msa-gold hover:text-primary-dark transition-colors">
            Bekijk onze banen
          </a>
          <a href={asset("/de-club")} class="text-center border border-white/30 text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors">
            Wie zijn wij
          </a>
          <a href={asset("/contact")} class="text-center border border-white/30 text-white px-6 py-3 rounded-lg font-semibold hover:bg-white/10 transition-colors">
            Bezoek ons
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Upcoming activities -->
  {upcoming.length > 0 && (
    <section class="py-12 md:py-16">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-baseline justify-between mb-8 flex-wrap gap-2">
          <h2 class="section-title text-2xl md:text-3xl font-medium text-primary font-heading uppercase tracking-normal">Aankomende activiteiten</h2>
          <a href={asset("/agenda")} class="btn">Volledige agenda</a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {upcoming.map((event, i) => <EventCard event={event} isNext={i === 0} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Featured layouts -->
  <section class="py-12 md:py-16 bg-primary-dark text-white">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex items-baseline justify-between mb-8 flex-wrap gap-2">
        <h2 class="section-title text-2xl md:text-3xl font-medium text-white font-heading uppercase tracking-normal">Onze banen</h2>
        <a href={asset("/banen")} class="btn btn-gold">Bekijk alle banen</a>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featuredBanen.map((baan) => (
          <LayoutCard
            title={baan.title}
            href={baan.href}
            scale={baan.scale}
            description={baan.description}
            status={baan.status}
            image={baan.image}
            dark
          />
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Ken Burns: each slide holds for SLIDE_SECONDS, zooming from its own origin,
       then crossfades into the next. Four slides at 8s = a 32s loop. */
    .hero-slide {
      opacity: 0;
      transform: scale(1.04);
      animation: hero-kenburns 32s linear infinite;
      will-change: transform, opacity;
    }

    @keyframes hero-kenburns {
      0%      { opacity: 0; transform: scale(1.04); }
      3%      { opacity: 1; }
      25%     { opacity: 1; }
      28%     { opacity: 0; transform: scale(1.16); }
      28.01%  { transform: scale(1.04); }
      100%    { opacity: 0; transform: scale(1.04); }
    }

    /* No drift, no crossfade: just the first frame. */
    @media (prefers-reduced-motion: reduce) {
      .hero-slide { animation: none; transform: none; opacity: 0; }
      .hero-slide:first-child { opacity: 1; }
    }
  </style>

  <!-- Nieuwsberichten -->
  {nieuws.length > 0 && (
    <section class="py-12 md:py-16">
      <div class="max-w-6xl mx-auto px-4">
        <div class="flex items-baseline justify-between mb-8 flex-wrap gap-2">
          <h2 class="section-title text-2xl md:text-3xl font-medium text-primary font-heading uppercase tracking-normal">Nieuws</h2>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {nieuws.map((item) => {
            const d = item.data.date;
            const Tag = item.data.link ? 'a' : 'div';
            const props = item.data.link
              ? { href: asset(item.data.link), class: 'group card card-hover bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm hover:border-primary/30' }
              : { class: 'card bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm' };
            return (
              <Tag {...props}>
                {item.data.image && (
                  <img src={asset(item.data.image)} alt="" loading="lazy" decoding="async" class="h-40 w-full object-cover" />
                )}
                <div class="card__body p-6">
                  <time datetime={d.toISOString().slice(0, 10)} class="text-xs uppercase tracking-wide text-gray-500">
                    {d.getDate()} {months[d.getMonth()]} {d.getFullYear()}
                  </time>
                  <h3 class="mt-1 font-semibold text-primary group-hover:text-primary-light transition-colors">{item.data.title}</h3>
                  <p class="mt-2 mb-4 text-sm text-gray-600">{item.data.summary}</p>
                  {item.data.link && (
                    <span class="btn">
                      Meer lezen
                    </span>
                  )}
                </div>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )}

</Base>
